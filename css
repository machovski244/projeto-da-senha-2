* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
}

body {
    background-color: #0f172a;
    color: #f8fafc;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 100vh;
}

.container {
    background-color: #1e293b;
    padding: 2rem;
    border-radius: 12px;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);
    width: 100%;
    max-width: 500px;
}

h2 {
    text-align: center;
    color: #38bdf8;
    margin-bottom: 0.25rem;
}

.subtitle {
    text-align: center;
    font-size: 0.85rem;
    color: #94a3b8;
    margin-bottom: 1.25rem;
}

.level-selector {
    display: flex;
    gap: 8px;
    margin-bottom: 1.25rem;
}

.level-btn {
    flex: 1;
    padding: 0.5rem;
    border: 1px solid #334155;
    background-color: #0f172a;
    color: #94a3b8;
    border-radius: 6px;
    cursor: pointer;
    font-weight: bold;
    transition: all 0.2s;
    font-size: 0.85rem;
}

.level-btn.active {
    background-color: #38bdf8;
    color: #0f172a;
    border-color: #38bdf8;
}

.vault-display {
    display: flex;
    justify-content: center;
    gap: 12px;
    margin-bottom: 1.25rem;
}

.digit-box {
    width: 60px;
    height: 70px;
    background-color: #090d16;
    border: 2px solid #334155;
    border-radius: 8px;
    display: flex;
    justify-content: center;
    align-items: center;
    font-size: 2rem;
    font-weight: bold;
    color: #475569;
    font-family: monospace;
    transition: all 0.3s ease;
}

.digit-box.unlocked {
    border-color: #22c55e;
    color: #22c55e;
    box-shadow: 0 0 12px rgba(34, 197, 94, 0.3);
}

.digit-box.current {
    border-color: #38bdf8;
    box-shadow: 0 0 10px rgba(56, 189, 248, 0.3);
}

.challenge-box {
    background-color: #0f172a;
    padding: 1.25rem;
    border-radius: 8px;
    margin-bottom: 1.25rem;
}

#step-title {
    font-size: 0.9rem;
    font-weight: bold;
    color: #38bdf8;
    margin-bottom: 0.5rem;
}

#problem-text {
    font-size: 1rem;
    color: #f8fafc;
    margin-bottom: 0.4rem;
    line-height: 1.4;
}

.hint {
    font-size: 0.85rem;
    color: #fbbf24;
    margin-bottom: 1rem;
    font-style: italic;
}

.input-group {
    display: flex;
    gap: 8px;
    margin-bottom: 0.5rem;
}

.input-group input {
    flex: 1;
    padding: 0.75rem;
    border-radius: 6px;
    border: 1px solid #334155;
    background-color: #1e293b;
    color: #fff;
    font-size: 1rem;
    outline: none;
}

.input-group button {
    padding: 0.75rem 1.2rem;
    border: none;
    background-color: #38bdf8;
    color: #0f172a;
    font-weight: bold;
    border-radius: 6px;
    cursor: pointer;
}

.input-group button:disabled {
    background-color: #475569;
    cursor: not-allowed;
}

.feedback {
    margin-top: 0.5rem;
    font-weight: bold;
    font-size: 0.9rem;
    min-height: 24px;
}

.feedback.correct { color: #22c55e; }
.feedback.wrong { color: #ef4444; }

.btn-primary {
    width: 100%;
    padding: 0.8rem;
    border: none;
    background-color: #22c55e;
    color: #fff;
    font-size: 1rem;
    font-weight: bold;
    border-radius: 6px;
    cursor: pointer;
}

.btn-primary:hover {
    background-color: #16a34a;
}
